# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
MODEL=openai/gpt-oss-20b
# hash = offline baseline, minilm = real semantic embeddings (pip install sentence-transformers)
EMBEDDER=hash
# lexical = offline, cross-encoder = neural reranker (needs sentence-transformers)
RERANKER=lexical
TOP_K=4
# leave empty for in-memory Qdrant, or e.g. http://localhost:6333
QDRANT_URL=
